	)
	(text "ESP32-S3 mendapat daya melalui USB-C. Adaptor 5 V \nmasuk melalui J5 dan dinaikkan menjadi 12 V oleh XL6009. \nQ1 mengendalikan catu ketiga sensor secara bersamaan. \nSemua rangkaian menggunakan GND bersama. J4 merupakan titik ukur \n12 V sebelum Q1"
		(exclude_from_sim no)
		(at 15.24 188.468 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9f062156-2391-4f4d-95ae-f0c719fcc9fe")
	)
	(text "sumber tegangan sensor rika 12V"
		(exclude_from_sim no)
		(at 59.944 158.242 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c2c152be-74f9-4db0-a94c-ef7111d2b585")
	)
	(text "Catu modem diambil dari adaptor 5 V sebelum \nXL6009 dan dikendalikan oleh GPIO14 melalui Q3-Q4. \nHubungkan J12 pin 1 ke 5VIN modem dan J12 pin 2 \nke GND POWER modem."
		(exclude_from_sim no)
		(at 282.448 74.168 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "ce1ef96d-02b5-4cee-ab58-cf56fc4f0173")
	)
